{
	"name": "NYT Crossword Replay",
	"version": "1.0",
	"manifest_version": 3,
	"description": "Record and replay timelapse animations of NYT crossword solves",
	"author": "coblesam360@gmail.com",
	"permissions": ["storage"],
	"content_scripts": [
		{
			"matches": [
				"https://www.nytimes.com/crosswords/game/daily/*",
				"https://www.nytimes.com/crosswords/game/daily"
			],
			"run_at": "document_idle",
			"js": ["webm_helpers.js", "content.js"]
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["icon128-full.png"],
			"matches": ["https://www.nytimes.com/*"]
		}
	],
	"icons": {
		"16": "icon16.png",
		"32": "icon32.png",
		"48": "icon48.png",
		"128": "icon128.png"
	}
}
